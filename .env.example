# Copy this file to .env and adjust values for your environment.
APP_NAME=AI-Powered Ethical Hacking Chatbot
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/ethical_hacking.db
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_UPLOAD_EXTENSIONS=txt,log,csv,json,md,pdf,py,js,java,php,c,cpp,sql
LOG_LEVEL=INFO
# Set LLM_PROVIDER=openai_compatible to call any OpenAI-compatible chat endpoint.
LLM_PROVIDER=disabled
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
